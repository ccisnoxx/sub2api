{
  "compilerOptions": {
    "target": "ES2020",
    "outDir": "./node_modules/.cache/vite-config",
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts", "vite-plugins/**/*.ts"],
  "exclude": ["vite-plugins/**/*.spec.ts"]
}
